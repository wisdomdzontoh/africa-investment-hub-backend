# ─────────────────────────── App ───────────────────────────
ENVIRONMENT=development            # development | staging | production
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://app.yourdomain.com
# Enable OpenAPI /docs (true in dev/staging, false in production)
ENABLE_DOCS=true
SECRET_KEY=change-me-please-generate-a-long-random-string

# Feature flags — Phase 2/3 endpoints return 501 until enabled
FEATURE_PHASE2=false
FEATURE_PHASE3=false

# ───────────────────────── Database ─────────────────────────
# EITHER: one full connection string (e.g. Neon's, pasted as-is) used by both
# the app and Alembic — leave empty to use the discrete parts below instead.
DATABASE_URL=
# OR: discrete parts. In docker-compose, host is "pgbouncer" (or "postgres"
# to bypass pooling)
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=6432
POSTGRES_USER=aih
POSTGRES_PASSWORD=aih_password
POSTGRES_DB=aih
# Direct connection (no pooler) for Alembic migrations
POSTGRES_DIRECT_HOST=postgres
POSTGRES_DIRECT_PORT=5432
# Require TLS on every DB connection — set true for managed Postgres (Neon, RDS)
POSTGRES_SSL=false

# ─────────────────────────── Redis ─────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─────────────── Field-level encryption (AES-256-GCM) ───────
# 32-byte key, urlsafe-base64 encoded. Generate:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# ─────────────────────────── Clerk ─────────────────────────
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUDIENCE=
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ─────────────────────────── OpenAI ────────────────────────
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_MODEL_CHEAP=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ───────────────────── Langfuse (LLM tracing) ──────────────
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=http://langfuse:3000

# ───────────────────── Cloudflare R2 (S3) ──────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aih-documents
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PRESIGN_EXPIRY_SECONDS=900

# ─────────────────────────── Resend ────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_ADMIN_INBOX=admin@yourdomain.com

# ─────────────────────────── Sentry ────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ───────────────────── News API (Phase 2) ──────────────────
NEWS_API_KEY=

# ──────────────────── Rate limiting (per minute) ───────────
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=20
